---
import '../styles/olivia.css';
import { oliviaCopy, privacyPath, bookingUrl, type OliviaLanguage } from '../data/olivia';
const { lang = 'es' } = Astro.props;
const language: OliviaLanguage = lang === 'zh' || lang === 'zh-Hans' ? 'zh' : lang === 'en' ? 'en' : 'es';
const copy = oliviaCopy[language];
---
<aside class="olivia-widget" data-olivia data-language={language} data-availability="checking" data-version="3.6">
  <section id="olivia-panel" class="olivia-panel" role="dialog" aria-modal="false" aria-labelledby="olivia-title" lang={language === 'zh' ? 'zh-Hans' : language} hidden>
    <div class="olivia-heading">
      <span class="olivia-avatar" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M16 3c1.5 8.5 4.5 11.5 13 13-8.5 1.5-11.5 4.5-13 13C14.5 20.5 11.5 17.5 3 16 11.5 14.5 14.5 11.5 16 3Z"/><path d="M26 3v6M23 6h6"/></svg></span>
      <div class="olivia-heading-copy"><div class="olivia-name"><strong id="olivia-title" data-olivia-copy="name">{copy.name}</strong><span class="olivia-version">3.6</span></div><span class="olivia-hotel">Business Suites SG</span><span class="olivia-presence" role="status" aria-live="polite"><i class="olivia-presence-dot" aria-hidden="true"></i><span data-olivia-availability>{copy.checking}</span></span></div>
      <button type="button" data-olivia-close aria-label={copy.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
    </div>
    <nav class="olivia-languages" aria-label={copy.languages}>
      <span data-olivia-copy="concierge">{copy.concierge}</span>
      {(['es', 'en', 'zh'] as const).map(code => <button type="button" data-olivia-language={code} lang={code === 'zh' ? 'zh-Hans' : code} aria-label={{ es: 'Español', en: 'English', zh: '简体中文' }[code]} aria-pressed={code === language}>{{ es: 'ES', en: 'EN', zh: '中文' }[code]}</button>)}
    </nav>
    <div class="olivia-messages" data-olivia-messages role="log" aria-live="polite" aria-relevant="additions text" aria-label={copy.name}>
      <p class="olivia-message olivia-message--assistant" data-olivia-welcome>{copy.welcome}</p>
    </div>
    <div class="olivia-actions">
      {copy.actions.map((action, index) => <button type="button" data-olivia-action={index} disabled><span data-olivia-action-label>{action.label}</span><span aria-hidden="true">↗</span></button>)}
    </div>
    <form class="olivia-form" data-olivia-form>
      <label class="olivia-consent"><input type="checkbox" data-olivia-consent required /><span><span data-olivia-copy="consentBefore">{copy.consentBefore}</span><a data-olivia-privacy href={privacyPath(language)} target="_blank" rel="noopener noreferrer" data-olivia-copy="privacy">{copy.privacy}</a><span data-olivia-copy="consentAfter">{copy.consentAfter}</span></span></label>
      <p class="olivia-status" data-olivia-status role="alert"></p>
      <label class="olivia-input-label" for="olivia-message" data-olivia-copy="message">{copy.message}</label>
      <div class="olivia-composer"><textarea id="olivia-message" data-olivia-input rows="1" maxlength="4000" required placeholder={copy.placeholder} disabled></textarea><button type="submit" data-olivia-send aria-label={copy.send} disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg></button></div>
    </form>
    <div class="olivia-links"><a href="mailto:contacto@businesssuitessg.com" data-olivia-copy="contact">{copy.contact}</a><a href="tel:+525536668535"><span data-olivia-copy="call">{copy.call}</span> ↗</a></div>
    <div class="olivia-footnote"><a data-olivia-booking href={bookingUrl(language)} target="_blank" rel="noopener noreferrer" data-olivia-copy="booking">{copy.booking}</a><span data-olivia-copy="footnote">{copy.footnote}</span></div>
  </section>
  <button class="olivia-launcher" data-olivia-open aria-controls="olivia-panel" aria-expanded="false" aria-label={copy.open} title={copy.name}>
    <span class="olivia-launcher-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M16 3c1.5 8.5 4.5 11.5 13 13-8.5 1.5-11.5 4.5-13 13C14.5 20.5 11.5 17.5 3 16 11.5 14.5 14.5 11.5 16 3Z"/></svg><i class="olivia-presence-dot"></i></span>
    <span class="olivia-launcher-copy"><strong data-olivia-copy="name">{copy.name}</strong><span><i class="olivia-presence-dot" aria-hidden="true"></i><span data-olivia-availability>{copy.checking}</span></span></span>
    <svg class="olivia-launcher-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 17 10-10M7 7h10v10"/></svg>
  </button>
</aside>
<script>
  import '../scripts/olivia';
</script>
