---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/header.css';
import { rooms } from '../data/rooms';
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const l = en ? 1 : 0;
const t = (es:string, english:string) => en ? english : es;
const booking = `https://hotels.cloudbeds.com/${lang}/reservation/Z2jMb3/`;
const maps = 'https://maps.app.goo.gl/xLqonEeihBtLZRte7';
const gallery = [
 {image:'corridor.jpg',label:t('La llegada','The arrival')},
 {image:'negra-kitchen.jpg',label:t('Los pequeños rituales','The little rituals')},
 {image:'morada-living.jpg',label:t('Un espacio con carácter','A space with character')},
 {image:'negra-bedroom.jpg',label:t('El arte de descansar','The art of unwinding')},
 {image:'courtyard-balcony.jpg',label:t('Una pausa, sólo tuya','A moment, just for you')}
];
const faqs = [
 [t('¿A qué hora puedo llegar?','When can I check in?'),t('El check-in es de 13:30 a 01:00 del día siguiente. La salida es antes de las 12:00. No contamos con recepción 24 horas, early check-in ni late check-out.','Check-in is from 1:30 pm to 1:00 am the following day. Check-out is before noon. Reception is not open 24 hours; early check-in and late check-out are not available.')],
 [t('¿Puedo quedarme por semanas o meses?','Can I stay for weeks or months?'),t('Sí. Ofrecemos tarifas especiales para estancias semanales y mensuales. Contacta directamente al hotel para conocer las condiciones y la disponibilidad.','Yes. We offer special rates for weekly and monthly stays. Contact the hotel directly for terms and availability.')],
 [t('¿Hay estacionamiento?','Is parking available?'),t('El estacionamiento es gratuito, con espacios muy limitados y sujeto a disponibilidad. Confirma con el hotel antes de tu llegada; hay estacionamientos públicos cercanos.','Parking is complimentary, with very limited spaces and subject to availability. Please confirm with the hotel before arrival; public parking is available nearby.')],
 [t('¿Las suites tienen aire acondicionado?','Do the suites have air conditioning?'),t('No contamos con aire acondicionado. Podemos facilitar un ventilador portátil o un calentador de ambiente.','The suites do not have air conditioning. A portable fan or space heater can be provided.')],
 [t('¿Qué debo saber antes de reservar?','What should I know before booking?'),t('Recibimos huéspedes a partir de 8 años. No se admiten mascotas, fiestas ni eventos. El horario de silencio es de 22:00 a 10:00. Sólo se permite fumar en los balcones. Consulta las condiciones de pago y cancelación de tu tarifa al reservar.','Guests aged 8 and older are welcome. Pets, parties and events are not permitted. Quiet hours are 10:00 pm to 10:00 am. Smoking is allowed on balconies only. Review the payment and cancellation terms for your selected rate when booking.')]
];
---
<!doctype html>
<html lang={lang}>
<head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1" />
 <meta name="theme-color" content="#402c31" />
 <meta name="robots" content="noindex, nofollow" />
 <title>{t('Business Suites SG · Tu espacio en Ciudad de México','Business Suites SG · Your place in Mexico City')}</title>
 <meta name="description" content={t('Seis suites con personalidad, cocina y espacio para vivir la Ciudad de México. Descubre Business Suites SG en Río Nazas 138, cerca de Reforma.','Six individual suites with kitchens and room to experience Mexico City. Discover Business Suites SG at Río Nazas 138, near Reforma.')} />
 <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
 <link rel="preload" href="/images/negra-bedroom.jpg" as="image" fetchpriority="high" />
</head>
<body>
 <a class="skip-link" href="#main">{t('Ir al contenido','Skip to content')}</a>
 <header class="site-header" id="header">
  <a class="brand" href={en?'/en/':'/'} aria-label="Business Suites SG — Home"><span class="monogram">SG<span class="monogram-dot">.</span></span><span class="brand-name">BUSINESS SUITES<span>CIUDAD DE MÉXICO</span></span></a>
  <nav class="desktop-nav" aria-label={t('Navegación principal','Main navigation')}>
   <a href="#esencia">{t('La esencia','The essence')}</a><a href="#suites">{t('Las suites','The suites')}</a><a href="#barrio">{t('El barrio','The neighbourhood')}</a><a href="#galeria">{t('Galería','Gallery')}</a>
  </nav>
  <div class="header-actions"><a class="language" href={en?'/':'/en/'} aria-label={en?'Cambiar a español':'Switch to English'}>{en?'ES':'EN'}</a><a class="header-book" href="#reservar">{t('Reservar','Book your stay')}<span>↗</span></a><button class="menu-toggle" aria-label={t('Abrir menú','Open menu')} aria-controls="mobile-menu"><span></span><span></span></button></div>
 </header>
 <main id="main">
  <section class="hero" aria-labelledby="hero-title">
   <div class="hero-slides" aria-hidden="true"><img src="/images/negra-bedroom.jpg" class="hero-slide active" alt="" fetchpriority="high" width="1396" height="1000"/><img src="/images/negra-kitchen.jpg" class="hero-slide" alt="" width="1600" height="999"/><img src="/images/naranja-kitchen.jpg" class="hero-slide" alt="" width="1500" height="1000"/></div>
   <div class="hero-shade"></div>
   <div class="hero-topline"><span class="tiny-star">✧</span><span>RÍO NAZAS 138 · CUAUHTÉMOC · CDMX</span><span class="tiny-star">✧</span></div>
   <div class="hero-content"><p class="eyebrow">{t('UNA FORMA DISTINTA DE HABITAR LA CIUDAD','A DIFFERENT WAY TO STAY IN THE CITY')}</p><h1 id="hero-title">{t('La ciudad, afuera.','The city, outside.')}<br/><em>{t('Tu mundo, aquí.','Your world, here.')}</em></h1><p class="hero-description">{t('Suites con personalidad. Espacio para ser tú.','Suites with character. Room to be yourself.')}</p><a class="hero-explore" href="#suites">{t('Encuentra tu suite','Find your suite')}<span>↗</span></a></div>
   <div class="hero-bottom"><span class="hero-note">{t('TU DIRECCIÓN EN CIUDAD DE MÉXICO','YOUR ADDRESS IN MEXICO CITY')}</span><div class="slide-control"><span id="slide-number">01</span><span class="slide-line"></span><span>03</span><button id="hero-prev" aria-label={t('Foto anterior','Previous photo')}>←</button><button id="hero-next" aria-label={t('Foto siguiente','Next photo')}>→</button></div><a class="scroll-cue" href="#esencia">{t('DESCUBRE','DISCOVER')}<span>↓</span></a></div>
  </section>
  <section class="reservation-wrap" id="reservar" aria-label={t('Reservar una estancia','Book a stay')}>
   <form class="booking-form" action={booking} method="get" target="_blank" rel="noopener">
    <input type="hidden" name="currency" value="mxn" />
    <div class="booking-intro"><span class="eyebrow">{t('QUÉDATE CON NOSOTROS','STAY WITH US')}</span><span>{t('Hazlo tuyo.','Make it yours.')}</span></div>
    <label><span>{t('LLEGADA','CHECK-IN')}</span><input type="date" id="checkin" name="checkin" required aria-label={t('Fecha de llegada','Check-in date')}/></label>
    <label><span>{t('SALIDA','CHECK-OUT')}</span><input type="date" id="checkout" name="checkout" required aria-label={t('Fecha de salida','Check-out date')}/></label>
    <label class="guest-field"><span>{t('HUÉSPEDES','GUESTS')}</span><select name="adults" aria-label={t('Número de adultos','Number of adults')}><option value="1">{t('1 adulto','1 adult')}</option><option value="2" selected>{t('2 adultos','2 adults')}</option></select></label>
    <button type="submit" class="solid-button">{t('Ver disponibilidad','Check availability')}<span>↗</span></button>
   </form>
   <div class="booking-footnote"><span>{t('Reserva directa · Tarifas y disponibilidad en tiempo real','Book direct · Live rates and availability')}</span><span>{t('Continúa en Cloudbeds','Continue on Cloudbeds')} ↗</span></div>
  </section>
  <section class="essence section-space" id="esencia">
   <div class="section-kicker"><span>01 / {t('LA ESENCIA','THE ESSENCE')}</span><span class="line"></span><span>BUSINESS SUITES SG</span></div>
   <div class="essence-layout"><div class="essence-copy reveal"><span class="small-ornament">✳</span><h2>{t('Hay lugares para dormir.','Some places are for sleeping.')}<br/><span class="muted">{t('Y lugares para','Others are for')} <em>{t('sentirte.','feeling at home.')}</em></span></h2><p>{t('Llegar. Dejar la maleta. Preparar un café. Y descubrir que, por unos días, la Ciudad de México también puede ser tu casa.','Arrive. Put down your suitcase. Make a coffee. And discover that, for a few days, Mexico City can be your home, too.')}</p><p>{t('En una discreta dirección de la colonia Cuauhtémoc, seis suites distintas reúnen la independencia de un departamento y la atención de un pequeño hospedaje. Para viajar por trabajo, por placer o por el gusto de quedarte un poco más.','At a discreet address in Colonia Cuauhtémoc, six individual suites combine the independence of an apartment with the personal attention of a small property. For business, for pleasure, or simply for the joy of staying a little longer.')}</p><a class="text-link" href="#suites">{t('Conoce tu próximo espacio','Discover your next space')}<span>↗</span></a></div>
    <div class="essence-photos reveal"><div class="photo-main"><img src="/images/corridor.jpg" alt={t('Pasillo de Business Suites SG con jardineras iluminadas','Business Suites SG corridor with illuminated planters')} loading="lazy"/><span class="vertical-caption">{t('EL ARTE DE SENTIRSE EN CASA','THE ART OF FEELING AT HOME')}</span></div><div class="photo-inset"><img src="/images/property-main.jpg" alt={t('Entrada del hotel en Río Nazas 138','Hotel entrance at Río Nazas 138')} loading="lazy"/><span>RÍO NAZAS, No. 138</span></div><div class="round-seal"><span>SEIS SUITES</span><strong>SG</strong><span>UNA CIUDAD</span></div></div>
   </div>
   <div class="essence-facts"><div><strong>06</strong><span>{t('suites, seis personalidades','suites, six personalities')}</span></div><div><strong>45–60<span> m²</span></strong><span>{t('en nuestras suites con superficie publicada','in our suites with published floor areas')}</span></div><div><strong>CDMX</strong><span>{t('un barrio por descubrir','a neighbourhood to discover')}</span></div></div>
  </section>
  <section class="suites-section section-space" id="suites">
   <div class="section-kicker"><span>02 / {t('LAS SUITES','THE SUITES')}</span><span class="line"></span><span>{t('ELIGE TU PERSONALIDAD','CHOOSE YOUR CHARACTER')}</span></div>
   <div class="section-heading reveal"><h2>{t('Un color. Un carácter.','A colour. A character.')}<br/><em>{t('Tu forma de quedarte.','Your way to stay.')}</em></h2><p>{t('Cada suite tiene su propia historia. Todas comparten lo esencial: espacio, independencia y una cálida bienvenida.','Every suite has its own story. All share the essentials: space, independence and a warm welcome.')}</p></div>
   <div class="suite-tabs" role="tablist" aria-label={t('Seleccionar suite','Choose a suite')}>
    {rooms.map((room,i)=><button role="tab" id={`tab-${i}`} aria-controls={`suite-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-room-tab={i}><span class="color-dot" style={`--dot:${room.color}`}></span>{room.name}<span class="tab-number">0{i+1}</span></button>)}
   </div>
   {rooms.map((room,i)=><article class="suite-panel" role="tabpanel" id={`suite-${i}`} aria-labelledby={`tab-${i}`} hidden={i!==0}>
    <div class="suite-image"><img src={`/images/${room.image}`} alt={`${t('Interior de la suite','Interior of Suite')} ${room.name}`} loading="lazy"/><span class="suite-image-label">SG / SUITE 0{i+1}</span><button class="image-expand" data-gallery-open data-images={`/images/${room.image}|/images/${room.secondary}`} data-caption={`Suite ${room.name}`} aria-label={t(`Ver fotos de la suite ${room.name}`,`View photos of Suite ${room.name}`)}>⤢</button></div>
    <div class="suite-description"><div class="suite-category"><span>{room.category[l]}{room.size ? ` · ${room.size}` : ''}</span><span>01–02 {t('HUÉSPEDES','GUESTS')}</span></div><h3>Suite <em>{room.name}</em><span style={`--dot:${room.color}`}></span></h3><p>{room.description[l]}</p><ul class="room-features">{room.features.map(f=><li><span>◇</span>{f[l]}</li>)}</ul><div class="suite-actions"><a class="solid-button" href={`${booking}?currency=mxn&accommodation_types=${[672970,672971,672972,672974,672975,672976][i]}`} target="_blank" rel="noopener">{t('Reservar esta suite','Book this suite')}<span>↗</span></a><button class="text-link" data-gallery-open data-images={`/images/${room.image}|/images/${room.secondary}`} data-caption={`Suite ${room.name}`}>{t('Explorar fotos','Explore photos')}<span>+</span></button></div><span class="suite-smallprint">{t('La disponibilidad y tarifa se confirman al reservar.','Availability and rates are confirmed when booking.')}</span></div>
   </article>)}
  </section>
  <section class="living-section">
   <div class="living-top section-space"><div class="section-kicker"><span>03 / {t('A TU RITMO','AT YOUR PACE')}</span><span class="line"></span><span>{t('LA VIDA, BIEN VIVIDA','LIFE, WELL LIVED')}</span></div><div class="section-heading reveal"><h2>{t('El lujo de tener','The luxury of')}<br/><em>{t('tu propio ritmo.','your own rhythm.')}</em></h2><p>{t('Un desayuno sin horarios. Una reunión bien preparada. Una noche que termina en tu propio espacio. Aquí, lo cotidiano se siente diferente.','Breakfast on your schedule. A well-prepared meeting. An evening that ends in your own space. Here, the everyday feels different.')}</p></div>
    <div class="living-features"><div><span class="feature-icon">⌂</span><h3>{t('Como en casa','Feel at home')}</h3><p>{t('Cocina en cada suite, sala y cama queen. La libertad de organizar tu día.','A kitchen in every suite, a living area and a queen bed. The freedom to make each day your own.')}</p></div><div><span class="feature-icon">⌁</span><h3>{t('Conecta a tu manera','Stay connected')}</h3><p>{t('Wi-Fi para tu trabajo y tus planes. Espacio para concentrarte y para desconectar.','Wi-Fi for work and all your plans. Space to focus, and room to switch off.')}</p></div><div><span class="feature-icon">✧</span><h3>{t('El cuidado se nota','Thoughtfully cared for')}</h3><p>{t('Limpieza diaria, atención personal y vigilancia nocturna durante tu estancia.','Daily cleaning, personal attention and night security during your stay.')}</p></div><div><span class="feature-icon">∞</span><h3>{t('Quédate un poco más','Stay a little longer')}</h3><p>{t('Tarifas especiales para estancias semanales y mensuales. Pregunta por tu próxima temporada.','Special rates for weekly and monthly stays. Ask us about your next chapter.')}</p></div></div>
   </div>
   <div class="slow-banner"><img src="/images/negra-kitchen.jpg" alt={t('Cocina y barra de desayuno de la suite Negra','Kitchen and breakfast bar in Suite Negra')} loading="lazy"/><div><span class="eyebrow">{t('TUS MAÑANAS. TUS PLANES. TU ESPACIO.','YOUR MORNINGS. YOUR PLANS. YOUR SPACE.')}</span><p>{t('No sólo visites la ciudad.','Don’t just visit the city.')}<br/><em>{t('Habítala.','Make it yours.')}</em></p><a href="#reservar" class="outline-button">{t('Empieza tu estancia','Begin your stay')}<span>↗</span></a></div></div>
  </section>
  <section class="neighbourhood section-space" id="barrio"><div class="section-kicker"><span>04 / {t('EL BARRIO','THE NEIGHBOURHOOD')}</span><span class="line"></span><span>19.4308° N · 99.1701° W</span></div><div class="neighbourhood-top"><div class="reveal"><span class="eyebrow">CUAUHTÉMOC, CIUDAD DE MÉXICO</span><h2>{t('Una dirección.','One address.')}<br/><em>{t('Mil posibilidades.','A thousand possibilities.')}</em></h2></div><p class="reveal">{t('A unas calles de Paseo de la Reforma, entre cafés, restaurantes y la energía de una ciudad que siempre tiene algo nuevo que contar. El punto de partida para hacerla tuya.','A few streets from Paseo de la Reforma, surrounded by cafés, restaurants and the energy of a city with a new story at every turn. Your starting point for making it your own.')}</p></div><div class="city-image"><img src="/images/reforma-panorama.jpg" alt={t('Silueta del Ángel de la Independencia al atardecer en Ciudad de México','Silhouette of the Angel of Independence at sunset in Mexico City')} loading="lazy"/><div class="city-image-caption"><span>{t('LA CIUDAD TE ESPERA','THE CITY AWAITS')}</span><strong>CDMX</strong><span>PASEO DE LA REFORMA</span></div></div><div class="neighbourhood-bottom"><div><span class="eyebrow">{t('ENCUÉNTRANOS','FIND US')}</span><h3>Río Nazas 138</h3><p>Col. Cuauhtémoc, 06500<br/>Ciudad de México, México</p><a class="text-link" href={maps} target="_blank" rel="noopener">{t('Cómo llegar','Get directions')}<span>↗</span></a></div><div class="neighbourhood-places"><div><span>01</span><strong>Paseo de la Reforma</strong><span>{t('Pasear & descubrir','Walk & discover')}</span></div><div><span>02</span><strong>Ángel de la Independencia</strong><span>{t('Un icono de la ciudad','A city icon')}</span></div><div><span>03</span><strong>Colonia Cuauhtémoc</strong><span>{t('Cafés & vida de barrio','Cafés & local life')}</span></div></div></div></section>
  <section class="gallery-section section-space" id="galeria"><div class="section-kicker"><span>05 / {t('UNA MIRADA','A CLOSER LOOK')}</span><span class="line"></span><span>BUSINESS SUITES SG</span></div><div class="gallery-heading"><h2>{t('Los detalles','The details')}<br/><em>{t('hacen el lugar.','make the place.')}</em></h2><button class="text-link" data-gallery-open data-images={gallery.map(x=>`/images/${x.image}`).join('|')} data-caption="Business Suites SG">{t('Abrir galería','Open gallery')}<span>↗</span></button></div><div class="gallery-grid">{gallery.map((photo,i)=><button class={`gallery-item gallery-item-${i}`} data-gallery-open data-images={gallery.map(x=>`/images/${x.image}`).join('|')} data-index={i} data-caption="Business Suites SG" aria-label={`${t('Ampliar foto','Enlarge photo')}: ${photo.label}`}><img src={`/images/${photo.image}`} alt={photo.label} loading="lazy"/><span class="gallery-label">{photo.label}<span>↗</span></span></button>)}</div></section>
  <section class="faq section-space"><div><span class="eyebrow">{t('ANTES DE LLEGAR','BEFORE YOU ARRIVE')}</span><h2>{t('Todo listo','Ready for')}<br/><em>{t('para tu estancia.','your stay.')}</em></h2><a class="text-link" href="tel:+525536668535">{t('Hablemos','Let’s talk')}<span>↗</span></a></div><div class="faq-list">{faqs.map(([q,a],i)=><details><summary><span class="faq-number">0{i+1}</span>{q}<span class="plus">+</span></summary><p>{a}</p></details>)}</div></section>
  <section class="final-cta"><span class="eyebrow">BUSINESS SUITES SG · CIUDAD DE MÉXICO</span><h2>{t('Tu próxima historia','Your next story')}<br/><em>{t('empieza aquí.','starts here.')}</em></h2><a href="#reservar" class="circle-cta" aria-label={t('Reserva tu estancia','Book your stay')}><span>↗</span><span>{t('RESERVAR','BOOK NOW')}</span></a><span class="cta-address">RÍO NAZAS No. 138</span></section>
 </main>
 <footer><div class="footer-main"><a class="brand footer-brand" href={en?'/en/':'/'}><span class="monogram">SG<span class="monogram-dot">.</span></span><span class="brand-name">BUSINESS SUITES<span>CIUDAD DE MÉXICO</span></span></a><div class="footer-address">Río Nazas 138, Col. Cuauhtémoc<br/>06500, Ciudad de México</div><div class="footer-contact"><a href="tel:+525536668535">+52 55 3666 8535</a><a href="mailto:hermannsgg@gmail.com">hermannsgg@gmail.com</a></div><a href="#main" class="back-top" aria-label={t('Volver arriba','Back to top')}>↑</a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Business Suites SG</span><span>{t('Concepto web por','Web concept by')} <strong>o7 Digital</strong></span><button id="credits-open">{t('Créditos fotográficos','Photo credits')}</button></div></footer>
 <dialog id="mobile-menu"><div class="mobile-menu-top"><span class="monogram">SG.</span><button data-close aria-label={t('Cerrar menú','Close menu')}>×</button></div><nav><a href="#esencia">{t('La esencia','The essence')}<span>01</span></a><a href="#suites">{t('Las suites','The suites')}<span>02</span></a><a href="#barrio">{t('El barrio','The neighbourhood')}<span>03</span></a><a href="#galeria">{t('Galería','Gallery')}<span>04</span></a><a href="#reservar">{t('Reservar','Book your stay')}<span>↗</span></a></nav><p>RÍO NAZAS 138 · CDMX</p></dialog>
 <dialog id="lightbox" aria-label={t('Galería de fotos','Photo gallery')}><div class="lightbox-top"><span id="lightbox-title">Business Suites SG</span><button data-close aria-label={t('Cerrar galería','Close gallery')}>×</button></div><div class="lightbox-content"><button id="lightbox-prev" aria-label={t('Foto anterior','Previous photo')}>←</button><img id="lightbox-image" src="/images/negra-bedroom.jpg" alt=""/><button id="lightbox-next" aria-label={t('Foto siguiente','Next photo')}>→</button></div><p id="lightbox-counter" aria-live="polite"></p></dialog>
 <dialog id="credits"><button data-close class="credits-close" aria-label={t('Cerrar','Close')}>×</button><h2>{t('Créditos fotográficos','Photo credits')}</h2><p>{t('Fotografías de Business Suites SG: galería del establecimiento en Cloudbeds.','Business Suites SG photographs: the property’s gallery on Cloudbeds.')}</p><p>{t('Ángel de la Independencia:','Angel of Independence:')} <span>Mario Yaír TS</span> · <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>. {t('Composición panorámica presentada con recorte de visualización.','Panoramic composition shown with display cropping.')} <a href="https://commons.wikimedia.org/wiki/File:Atardecer_en_el_Paseo_de_la_Reforma_en_Ciudad_de_M%C3%A9xico_2.jpg" target="_blank" rel="noopener">Wikimedia Commons ↗</a></p></dialog>
 <script>import '../scripts/interactions';</script>
</body>
</html>
